# Copy this file to .env and fill in the values.

# MongoDB connection string.
# MongoDB Atlas: Atlas -> Database -> Connect -> Drivers, then add the database name (/goldengroups) before the '?':
#   mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/goldengroups?retryWrites=true&w=majority
# Local development (npm run db:local):
DATABASE_URL="mongodb://127.0.0.1:27017/goldengroups?replicaSet=rs0&directConnection=true"

# Public URL of the site (used for WhatsApp links, SEO, sitemap)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Secret used to sign admin login sessions (keep private, 32+ random chars)
AUTH_SECRET=""

# First admin login (created by: npm run setup). Change the password after first login.
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD=""

# --- Optional instant lead alerts (leave empty to disable) ---
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""
RESEND_API_KEY=""
NOTIFY_EMAIL_TO=""
NOTIFY_EMAIL_FROM=""
