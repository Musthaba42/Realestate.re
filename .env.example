# Copy this file to .env and fill in the values.

# MongoDB connection string.
# MongoDB Atlas: Atlas -> Database -> Connect -> Drivers, then add the database name (/goldengroups) before the '?':
#   mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/goldengroups?retryWrites=true&w=majority
# Local development (npm run db:local):
DATABASE_URL="mongodb://127.0.0.1:27017/goldengroups?replicaSet=rs0&directConnection=true"

# Public URL of the site (used for WhatsApp links, SEO, sitemap)
NEXT_PUBLIC_SITE_URL="https://goldengroupsre.in"

# Secret used to sign admin login sessions (keep private, 32+ random chars)
AUTH_SECRET=""

# First admin login (created by: npm run setup). Change the password after first login.
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD=""

# --- Cloudflare R2: storage for photos, videos and documents ---
# Leave empty to keep files in MongoDB. To set up:
#   1. Cloudflare dashboard -> R2 Object Storage -> Create bucket (e.g. "goldengroups-media").
#      Keep it private (no public access needed; the site serves files itself).
#   2. R2 -> Manage API tokens -> Create API token -> "Object Read & Write", limited to that bucket.
#   3. Copy the Account ID, Access Key ID and Secret Access Key below.
# Move existing files from MongoDB to R2 with: npm run media:to-r2
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET=""

# --- Instant lead alerts (strongly recommended: without them nobody is told when a lead arrives) ---
# Telegram (free): create a bot with @BotFather, send it a message, then get your chat id.
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""
# Email via Resend (https://resend.com). RESEND_API_KEY + NOTIFY_EMAIL_FROM are also needed for
# "Forgot password" emails. NOTIFY_EMAIL_FROM must be an address on a domain verified in Resend.
RESEND_API_KEY=""
NOTIFY_EMAIL_TO=""
NOTIFY_EMAIL_FROM=""

# --- Optional spam protection: Cloudflare Turnstile (leave empty to disable) ---
# Cloudflare dashboard -> Turnstile -> Add widget (your domain + localhost), then copy both keys.
# Protects: I am Interested / loan / contact forms, Sell Your Property, sign-up, forgot password.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""
